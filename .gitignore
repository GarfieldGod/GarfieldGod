# ===== 依赖与构建产物（服务器上重新安装 / 构建，不进仓库）=====
node_modules/
.nuxt/
.output/
dist/
.static/

# ===== 本地环境配置（含后台口令、部署令牌等敏感信息）=====
.env
.env.*
!.env.example

# ===== 运行数据（数据库、上传文件、缓存、备份，均不进仓库）=====
# 以服务器上的数据为准，部署时不覆盖，每日 cron 备份。
.data/

# ===== 编辑器 / 操作系统杂项 =====
.DS_Store
Thumbs.db
desktop.ini
*.log
*.swp
*.swo
.vscode/
.idea/
