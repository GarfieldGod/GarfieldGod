# 复制为 .env 后按需填写。Nuxt 在 dev/build 时会自动读取 .env；
# 生产环境直接 `node .output/server/index.mjs` 不会自动加载，需用 systemd EnvironmentFile
# 或 `node --env-file=.env .output/server/index.mjs` 注入。

# ===== 后台访问控制（三选一，优先级：口令 > Cloudflare Access > 非生产放行）=====

# 1) 口令模式：设置后 /admin 走口令登录，换取 8 小时会话 cookie。
#    本地开发或尚未接入 Cloudflare Access 时使用。
# GG_ADMIN_PASSWORD=change-me

# 2) Cloudflare Access 模式：接入 Access 后设为 1，仅放行带
#    CF-Access-Authenticated-User-Email 头的请求。
# GG_TRUST_ACCESS=1

# 3) 共享密钥（可选，Access 模式下的纵深防御）：
#    配合 Cloudflare Transform Rule 给回源请求注入同值请求头，
#    即使源站 IP 暴露、攻击者伪造 CF 头也无法绕过。
# GG_ACCESS_SECRET=

# ===== 数据持久化 =====
# 数据库文件路径，默认 <cwd>/.data/garfieldgod.db
# GG_DB_PATH=/var/lib/garfieldgod/garfieldgod.db
# 上传目录，默认 <cwd>/.data/uploads
# GG_UPLOAD_DIR=/var/lib/garfieldgod/uploads

# ===== 访客统计 =====
# IP 哈希用的盐值。留空时首次启动会生成随机盐并落库复用（推荐直接留空）。
# 若手动设置，换了盐之后新旧记录的哈希对不上，跨天去重会失效（同一 IP 被算成两个人）。
# GG_VISIT_SALT=

# 访客明细保留天数（默认 90，至少 7）。只影响近 7 天趋势用的明细表，
# 历史累计访客来自独立集合，不受清理影响。
# GG_VISIT_KEEP_DAYS=90

# ===== 静态站生成（scripts/build-static.mjs）=====
# 生成器读同一份数据库与上传目录，产出可部署的纯静态目录（默认 dist/）。
# 手动生成：npm run build:static
#
# 后台保存内容后自动重新生成：设为 1 启用（默认关闭）。
# 开启后需保证服务器上有完整源码与 node_modules（构建在独立目录里跑，
# 不会覆盖正在运行的服务产物）。
# GG_STATIC_AUTOBUILD=1

# 静态产物输出目录，默认 <项目根>/dist
# GG_STATIC_DIST=dist

# 部署子路径。自定义域名或用户页（<user>.github.io）保持默认 /；
# GitHub Pages 项目页（<user>.github.io/<repo>/）要设成 /<repo>/
# GG_STATIC_BASE_URL=/

# ===== 静态站自动发布（scripts/auto-publish.mjs）=====
# 检测源站变更 → 生成静态站 → 提交并推送到部署仓库。手动执行：npm run publish:static
# 服务器上每天定时执行，例如 cron：
#   0 0 * * * cd /srv/garfieldgod-site && /usr/bin/node scripts/auto-publish.mjs >> .static/publish.log 2>&1
#
# 目标 GitHub 仓库地址。留空则只生成到 dist、不推送。
#   HTTPS + 令牌：https://<用户名>:<Token>@github.com/<用户名>/<仓库>.git
#   SSH 部署密钥：git@github.com:<用户名>/<仓库>.git
# 推荐用 SSH 部署密钥（仓库 Settings → Deploy keys，勾选 Allow write access）。
# GG_DEPLOY_REPO=

# 部署仓库在服务器上的本地克隆目录，默认 <项目根>/.static/deploy
# GG_DEPLOY_DIR=.static/deploy

# 推送分支，默认 main
# GG_DEPLOY_BRANCH=main

# 提交者信息，不设则用 git 全局配置
# GG_GIT_USER_NAME=GarfieldGod
# GG_GIT_USER_EMAIL=garfieldgod@users.noreply.github.com

# ===== 运行 =====
# NODE_ENV=production
# PORT=3000
